# ===== DeepSeek（生成模型，必填）=====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Ollama（本地嵌入模型 bge-m3，必填，需先 `ollama pull bge-m3`）=====
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3

# ===== 检索参数 =====
TOP_K=4

# ===== MCP（可选，默认关闭）=====
# 设为 true 会加载 filesystem MCP server（需本机有 node/npx）
MCP_ENABLED=false
MCP_FS_ENABLED=false
MCP_FS_PATH=./corpus
